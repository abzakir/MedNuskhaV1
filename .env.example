# ===========================================================================
#  MedNuskha - environment
#  Copy this to .env and fill it in. .env is gitignored; this file is not,
#  so it must never contain a real value.
#  Fill in the blanks below. Everything here is a FREE tier.
# ===========================================================================


# ---------------------------------------------------------------------------
#  1. WHATSAPP  -  BAILEYS BRIDGE                          [ NO KEYS NEEDED ]
# ---------------------------------------------------------------------------
#  WhatsApp runs through the Node bridge in whatsapp-bridge/ - open source,
#  no third party, unlimited contacts, nothing to sign up for.
#
#  To link a phone:   .\bridge.ps1      then scan the QR with the SPARE phone
#                     (WhatsApp > Settings > Linked devices > Link a device)
#
#  You only scan once. The login lives in whatsapp-bridge/auth_info/ and is
#  gitignored - it is real credentials, never commit or share it.
# ---------------------------------------------------------------------------
BRIDGE_URL=http://127.0.0.1:3001

#  Random string. It is part of the webhook URL so only the bridge can post
#  to us - without it, anyone could fake "the patient took her medicine".
WEBHOOK_SECRET=


# ---------------------------------------------------------------------------
#  2. AI KEYS  -  POOLED AND ROTATED                            [ REQUIRED ]
# ---------------------------------------------------------------------------
#  These are POOLS, not single keys. Separate them with commas.
#
#      GROQ_API_KEYS=gsk_first,gsk_second,gsk_third
#
#  Every free tier has a daily cap. When one key hits its limit the system
#  moves to the next one automatically and keeps working - it only stops if
#  every key is exhausted at the same moment. So: the more keys, the safer
#  the demo. Each teammate can make a free Groq account and add their key.
#
#  Get one at console.groq.com -> API Keys. No card required.
# ---------------------------------------------------------------------------
GROQ_API_KEYS=

#  Alibaba Model Studio. Leave blank until the hackathon credits arrive; when
#  they do, add them here and they join the same rotation automatically.
DASHSCOPE_API_KEYS=

#  Models. Groq hosts Qwen, so the Qwen story holds even before Alibaba.
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_WHISPER_MODEL=whisper-large-v3
DASHSCOPE_MODEL=qwen-plus

#  Seconds a key rests after being rate-limited, if the provider does not say.
LLM_COOLDOWN_SECONDS=60


# ---------------------------------------------------------------------------
#  3. DATABASE  -  SUPABASE                                        [ DONE ]
# ---------------------------------------------------------------------------
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=voice-notes
SUPABASE_REPORTS_BUCKET=reports

#  Writing to Storage needs the SECRET key, not the publishable one above.
#  Verified 2026-08-23: the publishable key can list buckets, but every write
#  comes back "new row violates row-level security policy".
#
#  Where: Supabase dashboard -> Project Settings -> API keys -> the key that
#  starts `sb_secret_`. It bypasses row-level security, so it is a real
#  secret - it must never reach the browser or the Next.js bundle.
#
#  Optional. Without it, reports are still generated and still open from the
#  link the caretaker gets on WhatsApp; they are just not archived to Storage,
#  and are rebuilt from the database each time instead. Phase 5's outbound
#  voice notes will need it too.
SUPABASE_SERVICE_KEY=


# ---------------------------------------------------------------------------
#  4. VOICE                                            [ NOTHING TO SET UP ]
# ---------------------------------------------------------------------------
#  Speaking: edge-tts. Free forever, no account, no card, no key.
#  Listening: Groq whisper-large-v3 (uses the pool above), and if that is
#  rate-limited or offline it falls back to faster-whisper on this machine.
#
#  Do NOT set WHISPER_MODEL back to "base" - it was measured transcribing
#  "abhi nahi" (not now) as "ab hi" (right now), inverting a dose reply.
# ---------------------------------------------------------------------------
TTS_VOICE=ur-PK-UzmaNeural
WHISPER_MODEL=small


# ---------------------------------------------------------------------------
#  5. APP
# ---------------------------------------------------------------------------
TIMEZONE=Asia/Karachi

#  Minutes of silence before the follow-up, and before the caretaker alert.
#  Set both to 1 and 2 for the live demo (AGENTS.md section 15).
FOLLOWUP_MINUTES=15
ESCALATE_MINUTES=30

NEXT_PUBLIC_API_BASE=http://localhost:8000

#  Treat unauthenticated requests as a dev caretaker. Handy while
#  building; must be false in production.
DEV_AUTH_BYPASS=false
