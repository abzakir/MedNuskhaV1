# MedNuskha — environment variables (AGENTS.md §13).
# Copy to .env and fill in. .env is gitignored: never commit real values.

# --- WhatsApp (Meta Cloud API, direct) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0

# --- Alibaba Cloud (Model Studio / DashScope: Qwen + Qwen-VL) ---
DASHSCOPE_API_KEY=

# --- Voice ---
GOOGLE_APPLICATION_CREDENTIALS=
WHISPER_MODEL=base

# --- Data ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=voice-notes

# --- App ---
TIMEZONE=Asia/Karachi
FOLLOWUP_MINUTES=15
ESCALATE_MINUTES=30
NEXT_PUBLIC_API_BASE=http://localhost:8000
