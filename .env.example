# ===========================================================================
#  MedNuskha - environment
#  Copy this to .env and fill it in. .env is gitignored; this file is not,
#  so it must never contain a real value.
#  Fill in the blanks below. Everything here is a FREE tier.
# ===========================================================================


# ---------------------------------------------------------------------------
#  1. WHATSAPP  -  GREEN-API                                    [ REQUIRED ]
# ---------------------------------------------------------------------------
#  green-api.com -> register -> create an instance -> scan the QR code with
#  the SPARE phone (never a personal number).
#  The free Developer plan allows 3 chats: patient + caretaker + one spare.
#
#  Both values are on the instance page.
# ---------------------------------------------------------------------------
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=

GREEN_API_URL=https://api.green-api.com
GREEN_API_MEDIA_URL=https://media.green-api.com

#  Any random string you invent. It is appended to the webhook path so only
#  Green API can post to us. Set the same value in the Green API console.
WEBHOOK_SECRET=


# ---------------------------------------------------------------------------
#  2. AI KEYS  -  POOLED AND ROTATED                            [ REQUIRED ]
# ---------------------------------------------------------------------------
#  These are POOLS, not single keys. Separate them with commas.
#
#      GROQ_API_KEYS=gsk_first,gsk_second,gsk_third
#
#  Every free tier has a daily cap. When one key hits its limit the system
#  moves to the next one automatically and keeps working - it only stops if
#  every key is exhausted at the same moment. So: the more keys, the safer
#  the demo. Each teammate can make a free Groq account and add their key.
#
#  Get one at console.groq.com -> API Keys. No card required.
# ---------------------------------------------------------------------------
GROQ_API_KEYS=

#  Alibaba Model Studio. Leave blank until the hackathon credits arrive; when
#  they do, add them here and they join the same rotation automatically.
DASHSCOPE_API_KEYS=

#  Models. Groq hosts Qwen, so the Qwen story holds even before Alibaba.
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_WHISPER_MODEL=whisper-large-v3
DASHSCOPE_MODEL=qwen-plus

#  Seconds a key rests after being rate-limited, if the provider does not say.
LLM_COOLDOWN_SECONDS=60


# ---------------------------------------------------------------------------
#  3. DATABASE  -  SUPABASE                                        [ DONE ]
# ---------------------------------------------------------------------------
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=voice-notes


# ---------------------------------------------------------------------------
#  4. VOICE                                            [ NOTHING TO SET UP ]
# ---------------------------------------------------------------------------
#  Speaking: edge-tts. Free forever, no account, no card, no key.
#  Listening: Groq whisper-large-v3 (uses the pool above), and if that is
#  rate-limited or offline it falls back to faster-whisper on this machine.
#
#  Do NOT set WHISPER_MODEL back to "base" - it was measured transcribing
#  "abhi nahi" (not now) as "ab hi" (right now), inverting a dose reply.
# ---------------------------------------------------------------------------
TTS_VOICE=ur-PK-UzmaNeural
WHISPER_MODEL=small


# ---------------------------------------------------------------------------
#  5. APP
# ---------------------------------------------------------------------------
TIMEZONE=Asia/Karachi

#  Minutes of silence before the follow-up, and before the caretaker alert.
#  Set both to 1 and 2 for the live demo (AGENTS.md section 15).
FOLLOWUP_MINUTES=15
ESCALATE_MINUTES=30

NEXT_PUBLIC_API_BASE=http://localhost:8000
