# MedNuskha — environment variables (AGENTS.md §13).
# Copy to .env and fill in. .env is gitignored: never commit real values.

# --- WhatsApp (Meta Cloud API, direct) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANG=en                 # must match what you submitted to Meta

# --- Alibaba Cloud (Model Studio / DashScope: Qwen + Qwen-VL) ---
DASHSCOPE_API_KEY=

# --- Voice (edge-tts needs no key, account or card) ---
TTS_VOICE=ur-PK-UzmaNeural
WHISPER_MODEL=small                       # do not use "base" - it inverts Urdu negations

# --- Data ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=voice-notes

# --- App ---
TIMEZONE=Asia/Karachi
FOLLOWUP_MINUTES=15
ESCALATE_MINUTES=30
NEXT_PUBLIC_API_BASE=http://localhost:8000
