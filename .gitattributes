# Normalise to LF in the repo. The backend ships to an Ubuntu ECS box in
# Phase 8, where a CRLF Makefile or shell script silently breaks.
* text=auto eol=lf

# PowerShell shims stay CRLF - they only ever run on Windows.
*.ps1  text eol=crlf

# Makefile is tab-sensitive and must be LF.
Makefile text eol=lf

# Binaries git must not touch.
*.pdf   binary
*.png   binary
*.jpg   binary
*.ico   binary
*.ogg   binary
*.woff  binary
*.woff2 binary
