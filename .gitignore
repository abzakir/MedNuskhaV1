# secrets
# Ignore EVERY .env variant, then re-allow only the example. A .env.backup
# holding real credentials sitting untracked is exactly how secrets get
# committed by an absent-minded `git add -A`.
.env
.env.*
!.env.example
*.pem
*service-account*.json
gcp-credentials.json

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# WhatsApp login credentials (Baileys session). Anyone holding this
# folder can read the linked account's messages.
whatsapp-bridge/auth_info/
auth_info/
auth_info_*/

# node / next
node_modules/
.next/
out/
.vercel/
frontend/.env*.local

# models / generated media
.whisper-cache/
*.ogg
*.pdf
!MedNuskha_PRD_v1.0.pdf
!MedNuskha_Setup_Guide.pdf

# os / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# Generated report PDFs from scripts/verify/verify_reports.py
scripts/verify/_out/

# Pre-generated voice notes. Content-addressed, regenerates itself.
backend/.voice-cache/
